-- Core measures
Total Revenue = SUM(cleaned_transactions[revenue])

Total Orders = DISTINCTCOUNT(cleaned_transactions[invoice_no])

Total Customers = DISTINCTCOUNT(cleaned_transactions[customer_id])

Average Order Value = DIVIDE([Total Revenue], [Total Orders])

Units Sold = SUM(cleaned_transactions[quantity])

Repeat Customers =
CALCULATE(
    COUNTROWS(customer_360),
    customer_360[is_repeat_customer] = TRUE()
)

Repeat Customer Rate =
DIVIDE([Repeat Customers], COUNTROWS(customer_360))

-- Time intelligence
Revenue Previous Month =
CALCULATE([Total Revenue], DATEADD('Date'[Date], -1, MONTH))

Revenue MoM Change = [Total Revenue] - [Revenue Previous Month]

Revenue MoM Growth % =
DIVIDE([Revenue MoM Change], [Revenue Previous Month])

-- Customer segment measures
Champion Revenue =
CALCULATE(
    SUM(rfm_segments[monetary]),
    rfm_segments[segment] = "Champions"
)

At Risk Revenue =
CALCULATE(
    SUM(rfm_segments[monetary]),
    rfm_segments[segment] = "At Risk"
)

Segment Customers = DISTINCTCOUNT(rfm_segments[customer_id])

Segment Revenue = SUM(rfm_segments[monetary])

Segment Revenue Share =
DIVIDE(
    [Segment Revenue],
    CALCULATE([Segment Revenue], ALL(rfm_segments[segment]))
)

-- Cohort measures; use cohort_index as the visual column or filter
Active Cohort Customers = SUM(cohort_retention[active_customers])

Cohort Base = SUM(cohort_retention[cohort_size])

Weighted Retention Rate =
DIVIDE([Active Cohort Customers], [Cohort Base])

-- Create this calculated table and mark it as the date table
Date =
CALENDAR(
    MIN(cleaned_transactions[invoice_date_only]),
    MAX(cleaned_transactions[invoice_date_only])
)

Year = YEAR('Date'[Date])

Month Number = MONTH('Date'[Date])

Month = FORMAT('Date'[Date], "MMM")

Year Month = FORMAT('Date'[Date], "YYYY-MM")

